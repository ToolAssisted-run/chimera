<Project Sdk="Microsoft.NET.Sdk">
	<!--
		Level A tester for the pure-C# Synth flavor (runs under Mono/net48).
		Compiles SynthMachine.cs directly - the machine, not the adapter, is
		under test; no contract DLLs are involved here.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net48</TargetFramework>
		<AssemblyName>synth-run-sharp</AssemblyName>
		<RootNamespace>MiniHawk.Cores.SynthSharp</RootNamespace>
		<LangVersion>preview</LangVersion>
		<Nullable>disable</Nullable>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="Program.cs" />
		<Compile Include="../source/SynthMachine.cs" />
	</ItemGroup>
</Project>
