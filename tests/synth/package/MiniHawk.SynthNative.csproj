<Project Sdk="Microsoft.NET.Sdk">
	<!--
		The native-flavor Synth core package for the miniHawk synthetic witness
		(tests/synth/SPEC.md). Builds against the published miniHawk core contract
		from <MiniHawkRoot>/build/dll, exactly as an out-of-repo package would -
		this project is deliberately NOT part of BizHawk.sln (test fixture, not a
		product core). MiniHawkRoot defaults to this repository's own root.
	-->
	<PropertyGroup>
		<MiniHawkRoot Condition=" '$(MiniHawkRoot)' == '' ">$(MSBuildProjectDirectory)/../../..</MiniHawkRoot>
		<TargetFramework>net48</TargetFramework>
		<AssemblyName>MiniHawk.SynthNative</AssemblyName>
		<RootNamespace>MiniHawk.Cores.Synth</RootNamespace>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>disable</Nullable>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<Using Include="System" />
		<PackageReference Include="System.Memory" Version="4.6.3" />
		<Compile Include="source/**/*.cs" />
		<Reference Include="BizHawk.Common" HintPath="$(MiniHawkRoot)/build/dll/BizHawk.Common.dll" Private="false" />
		<Reference Include="BizHawk.BizInvoke" HintPath="$(MiniHawkRoot)/build/dll/BizHawk.BizInvoke.dll" Private="false" />
		<Reference Include="BizHawk.Emulation.Common" HintPath="$(MiniHawkRoot)/build/dll/BizHawk.Emulation.Common.dll" Private="false" />
	</ItemGroup>
</Project>
