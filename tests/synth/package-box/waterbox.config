{
	"coreName": "Synth",
	"systemId": "Synth",
	"systemNames": { "Synth": "Synthetic Witness" },
	"abi": 1,
	"runsOn": [ "windows-x86_64", "windows-aarch64", "linux-x86_64", "linux-aarch64", "macos-x86_64", "macos-aarch64" ],
	"romFile": "rom",
	"deterministic": true,
	"memoryLayoutMiB": [ 16, 16, 16, 16, 32 ],
	"video": {
		"width": 128,
		"height": 120,
		"virtualWidth": 256,
		"virtualHeight": 240,
		"vsyncNumerator": 60,
		"vsyncDenominator": 1,
		"getBgra": "GetVideoBgra"
	},
	"audio": {
		"samplesPerFrame": 735,
		"channels": 1,
		"get": "GetAudio"
	},
	"input": {
		"name": "Synth Controller",
		"buttons": [ "P1 Up", "P1 Down", "P1 Left", "P1 Right", "P1 A", "P1 B", "P1 Select", "P1 Start" ],
		"mnemonics": { "Up": "U", "Down": "D", "Left": "L", "Right": "R", "A": "A", "B": "B", "Select": "s", "Start": "S" },
		"headers": { "Select": "SEL" }
	},
	"lag": {
		"inputWasRead": "InputWasRead"
	},
	"extensions": {
		".testrom": "Synth"
	},
	"settings": [
		{
			"name": "initFillByte",
			"display": "setting.initfillbyte",
			"description": "setting.initfillbyte.about",
			"type": "int",
			"min": 0,
			"max": 255,
			"default": 0,
			"sync": true
		}
	],
	"tools": [
		{
			"id": "make_project",
			"menu": "tool.make_project",
			"description": "tool.make_project.about",
			"inputs": [],
			"options": [
				{ "name": "broken", "display": "tool.make_project.broken", "description": "tool.make_project.broken.about", "default": false }
			],
			"outputs": [
				{ "name": "project", "label": "tool.make_project.project", "extension": "chimeraProject", "project": true }
			]
		}
	]
}
