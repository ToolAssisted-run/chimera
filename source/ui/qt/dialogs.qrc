<!DOCTYPE RCC>
<RCC version="1.0">
  <!-- Qt's dialogs drawn inside their window (dialogs/qmldir); the theme test loads them too -->
  <qresource prefix="/qt/qml/ChimeraDialogs">
    <file alias="qmldir">dialogs/qmldir</file>
    <file alias="FileDialog.qml">dialogs/FileDialog.qml</file>
    <file alias="FolderDialog.qml">dialogs/FolderDialog.qml</file>
    <file alias="PickerBase.qml">dialogs/PickerBase.qml</file>
    <file alias="BuiltinChooser.qml">dialogs/BuiltinChooser.qml</file>
    <file alias="MessageDialog.qml">dialogs/MessageDialog.qml</file>
    <file alias="ColorDialog.qml">dialogs/ColorDialog.qml</file>
    <file alias="FontDialog.qml">dialogs/FontDialog.qml</file>
  </qresource>
</RCC>
