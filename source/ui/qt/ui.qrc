  <!-- Chimera's style: Fusion, with the system's check boxes and radio buttons, as Chimera's, scroll bars always seen, and dialogs that end a headless run -->
  <qresource prefix="/qt/qml/ChimeraStyle">
    <file alias="qmldir">style/qmldir</file>
    <file alias="CheckBox.qml">style/CheckBox.qml</file>
    <file alias="Dialog.qml">style/Dialog.qml</file>
    <file alias="MenuBarItem.qml">style/MenuBarItem.qml</file>
    <file alias="MenuItem.qml">style/MenuItem.qml</file>
    <file alias="RadioButton.qml">style/RadioButton.qml</file>
    <file alias="ScrollBar.qml">style/ScrollBar.qml</file>
    <file alias="ScrollView.qml">style/ScrollView.qml</file>
