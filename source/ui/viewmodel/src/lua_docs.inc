{"library": "gameinfo", "name": "getstatus", "returns": "string", "params": "()", "args": [], "description": "returns the game database status of the currently loaded rom. Statuses are for example: GoodDump, BadDump, Hack, Unknown, NotInDatabase", "example": "local stgamget = gameinfo.getstatus( );", "deprecated": false, "unavailable": false},
{"library": "gameinfo", "name": "isstatusbad", "returns": "boolean", "params": "()", "args": [], "description": "returns the currently loaded rom's game database status is considered 'bad'", "example": "if ( gameinfo.isstatusbad( ) ) then\r\n\tconsole.log( \"returns the currently loaded rom's game database status is considered 'bad'\" );\r\nend;", "deprecated": false, "unavailable": false},
