<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
	</PropertyGroup>
	<Import Project="../MainSlnTest.props" />
	<PropertyGroup>
		<!--
			These tests construct real WinForms windows, so they need a display: on
			Linux that means Xvfb (tests/ui/run-ui-tests.sh sets one up). They are
			kept in their own project so the display-free logic tests in
			Chimera.Tests.Client.Common stay runnable anywhere.
		-->
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="$(ProjectDir)../Chimera.Client.EmuHawk/Chimera.Client.EmuHawk.csproj" />
		<ProjectReference Include="$(ProjectDir)../Chimera.Tests.Common/Chimera.Tests.Common.csproj" />
	</ItemGroup>
	<!--
		The frontend's build renames its output to EmuHawk.exe and moves it to build/,
		so the copy a ProjectReference leaves here is named EmuHawk.exe while the
		assembly inside is still Chimera.Client.EmuHawk - which is the name the
		runtime probes for, and does not find. Put a correctly-named copy beside the
		test assembly so ordinary probing works.
	-->
	<Target Name="CopyFrontendForProbing" AfterTargets="Build">
		<Copy
			SourceFiles="$(ProjectDir)../../build/EmuHawk.exe"
			DestinationFiles="$(OutputPath)Chimera.Client.EmuHawk.exe"
			SkipUnchangedFiles="true"
			Condition="Exists('$(ProjectDir)../../build/EmuHawk.exe')" />
	</Target>
</Project>
